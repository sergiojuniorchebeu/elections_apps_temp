# Copy to config/dev.json (git-ignored) and run:
#   flutter run --dart-define-from-file=config/dev.json
# Nothing here is a secret: the app never embeds private keys. Keys of
# third-party services (push, crash reporting) belong to YOUR build setup.
BACKEND=mock            # mock | rest | your own value (see lib/backend.dart)
API_BASE_URL=           # https://api.example.org/v1 (https required, except localhost)
SUPPORT_EMAIL=support@example.org
APP_NAME=Votaa
MOCK_LATENCY_MS=        # empty = 300–800 ms; 0 = instant
APP_VERSION=0.1.0
